# Copy this file to `.env` and adjust values. `.env` is git-ignored; this file is not.

# --- Database ---
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
# Matches the credentials in docker-compose.yml
DATABASE_URL=postgresql+asyncpg://docintel:docintel@localhost:5433/docintel

# --- Ollama (local LLM server) ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
EMBEDDING_MODEL=nomic-embed-text
# nomic-embed-text produces 768-dimensional vectors. If you change the
# embedding model you MUST change this to match, and re-embed all documents.
EMBEDDING_DIMENSIONS=768
# nomic-embed-text expects these task prefixes. If you change them (or the
# model) run `python -m scripts.reembed` so stored vectors match.
EMBEDDING_DOCUMENT_PREFIX="search_document: "
EMBEDDING_QUERY_PREFIX="search_query: "

# --- Document processing ---
UPLOAD_DIR=./uploads
CHUNK_SIZE=800          # characters per chunk
CHUNK_OVERLAP=150       # characters shared between adjacent chunks

# --- Retrieval ---
# Combine semantic (pgvector) and keyword (Postgres full-text) search with
# reciprocal rank fusion. Keyword search catches exact numbers and acronyms
# that embeddings blur. Set false to compare against pure vector search.
HYBRID_SEARCH=true

# --- Answer quality ---
# Cosine similarity of the BEST retrieved chunk below this means the documents
# don't cover the question; we answer "not covered" without calling the LLM.
# Observed with nomic prefixes: paper questions ~0.75+, resume questions
# 0.51-0.63, off-topic 0.50-0.54. Ignored when a question is scoped to one
# document — the user has said where to look, so the model decides.
RELEVANCE_THRESHOLD=0.55
# How long to wait for Ollama before returning 504. CPU inference takes 30-90s.
LLM_TIMEOUT_SECONDS=180

